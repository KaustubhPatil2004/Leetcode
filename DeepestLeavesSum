class Solution {
private:
    int maxlevel=0, sum=0;
    void length(TreeNode* root, int level) {
        if (root==nullptr) {
            return ;
        }
        if (level>maxlevel) {
            sum=0; 
            maxlevel=level;
        }
        if (level==maxlevel) {
            sum+=root->val;
        }
        length(root->right, level+1);
        length(root->left, level+1);
    }

public:
    int deepestLeavesSum(TreeNode* root) {
        if (root==nullptr) {
            return 0;
        }
        length(root, 0);
        return sum;
    }
};
