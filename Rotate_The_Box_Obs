class Solution {
public:
    vector<vector<char>> rotateTheBox(vector<vector<char>>& boxGrid) {
        int row = boxGrid.size();
        int col = boxGrid[0].size();
        vector<vector<char>> ans(col, vector<char>(row));

        for (int i = 0; i < row; i++) {
            int p1 = 0;
            int p2 = 1;
            while (p2 < col && p1<col) {

                 if (boxGrid[i][p2] =='*') { // When ever obstacle occured start over again
                    p1 = p2 + 1;
                    p2 = p1 + 1;
                }
                
                 else if (boxGrid[i][p1] == '*') {  
                   p1 = p1 + 1;
                   p2 = p1 + 1;
                }

                 else if(boxGrid[i][p1] == '.') {
                    p1++;
                    if(p1 == p2) p2++;
                }

                else if (boxGrid[i][p1] == '#' && boxGrid[i][p2] == '.') { // Swaping for empty space
                    swap(boxGrid[i][p1], boxGrid[i][p2]);
                    p1++;
                    p2++;
            }
            else{
                p2++;
            }
        }
    }

        // Rotate the Box
        for (int i = 0; i < row; i++) {
            for (int j = 0; j < col; j++) {
                ans[j][row - 1 - i] = boxGrid[i][j];
            }
        }

        return ans;
    }
};
