class Solution {
public:
    int numIdenticalPairs(vector<int>& nums) {
        int count = 0;
        sort(nums.begin(), nums.end());
        int l = 0;
        int r = 1;

        while (r < nums.size()) {

            if (nums[r] == nums[l]) {
                while (r<nums.size()&&nums[r] == nums[l]) {
                    r++;
                }
                int k=r-l;
                count +=k*(k-1) / 2;
                l = r;
                continue;
            }
            r++;
            l++;
        }
       return count;
    }
};
