/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    vector<ListNode*> splitListToParts(ListNode* head, int k) {
        vector<ListNode*>ans(k);

         if(head==NULL){
            return ans;
         } 

        ListNode*temp=head;
        int size=0;
        while(temp!=NULL){
            size++;
            temp=temp->next;
        }
        
        int adjust=size%k;
         
        int sub=size/k;

        ListNode*t1=head;
        ListNode*prev=NULL;

        for(int i=0;i<k;i++){
            ans[i]=t1;
            for(int j=0;j<sub;j++){
                if(t1==NULL){
                    break;
                }
               prev=t1;
               t1=t1->next;
            }
            if(adjust>0 && t1!=NULL){
                prev=t1;
                t1=t1->next;
                adjust--;
            }
            prev->next=NULL;
        }
        return ans;
    }
};
