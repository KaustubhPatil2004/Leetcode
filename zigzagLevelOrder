/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left),
 * right(right) {}
 * };
 */
class Solution {
public:
    vector<vector<int>> zigzagLevelOrder(TreeNode* root) {
        vector<vector<int>> ans;
        vector<int> level;
        if (root == NULL) {
            return ans;
        }                                                         
        int indicator = 0;                                    
        queue<TreeNode*> q;
        q.push(root);
        q.push(NULL);

        while (!q.empty()) {
            TreeNode* temp = q.front();
            q.pop();

            if (temp == NULL) {
                if (indicator % 2 == 0) {                                  //Even level push as it present in level
                    ans.push_back(level);
                    level.clear();
                    indicator++;
                } else {
                    reverse(level.begin(), level.end());                    //odd level push after reversing it 
                    ans.push_back(level);
                    level.clear();
                    indicator++;
                }
                
                if(!q.empty()){                                              //After the level push again seperator
                    q.push(NULL);
                }
            }
            else{
            level.push_back(temp->val);
            if(temp->left !=NULL){                                         //Left child in Queue
                q.push(temp->left);
            }
            if(temp->right != NULL){                                       //Right child in Queue
                q.push(temp->right);
            }
            }
        }
        return ans;
    }
};
