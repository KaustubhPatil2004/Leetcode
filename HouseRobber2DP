class Solution {
public:
    int memo(vector<int>& nums, vector<int>& dp, int start, int n) {
        if (n == start)   return nums[n];
        
        if (n < start)   return 0;

        if (dp[n] != -1)  return dp[n];

        int pick = nums[n] + memo(nums, dp, start,n-2);
        int notpick = 0 + memo(nums, dp,start, n - 1);
        return dp[n] = max(pick, notpick);
    }
    int rob(vector<int>& nums) {
        if(nums.size()==1) return nums[0];
        int n = nums.size();
        vector<int> dp(n + 1, -1);
         vector<int>dp2(n+1,-1);
        return max(memo(nums,dp,0,n-2),memo(nums,dp2,1,n-1));
    }
};
