class Solution {
public:
    string removeOccurrences(string s, string part) {
        string ans="";
        int size=part.size();

        for(int i=0;i<s.size();i++){
            ans.push_back(s[i]);

            if(ans.size()>=size && ans.substr(ans.size()-size,size)==part){
                ans.erase(ans.size()-size,size);
            }
        }
        return ans;
    }
};
