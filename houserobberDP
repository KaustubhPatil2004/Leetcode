class Solution {
public:
   int memo(vector<int>&nums,vector<int>&dp,int index){
   if(index==0){
    return nums[0];
   } 
   if(index<0){
    return 0;
   }
   
   if(dp[index]!=-1) return dp[index];

   int s1=0;
   int s2=0;

   s1=nums[index] + memo(nums,dp,index-2);
   s2= memo(nums,dp,index-1);
   
   return dp[index]=max(s1,s2);
   }
    int rob(vector<int>& nums) {
        int prev=nums[0];
        int prev2=0;

        for(int i=1;i<nums.size();i++){
           int s1=nums[i];
           if(i>1) s1+=prev2;
           int s2=prev;

           int dp=max(s1,s2);
           prev2=prev;
           prev=dp;
        }
        return prev;
    }
};
