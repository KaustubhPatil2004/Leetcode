class Solution {
public:
    int minimumDistance(vector<int>& nums) {
        if(nums.size()<=2) return -1;
        
        int mini=INT_MAX;

        map<int,vector<int>>M;

      for(int i=0;i<nums.size();i++){
        M[nums[i]].push_back(i);
      }


      for(auto &it:M){
        if(it.second.size()>2){
            for(int i=1;i<it.second.size()-1;i++){
            int record=abs(it.second[i]-it.second[i-1]) +abs(it.second[i+1]-it.second[i])+abs(it.second[i+1]-it.second[i-1]);
            mini=min(mini,record);
            }   
        }
      }
      if(mini==INT_MAX) return -1;
      else return mini;
    }
};
