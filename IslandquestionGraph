class Solution {
public:
    void bfs(vector<vector<int>>& visited, vector<vector<char>>& grid, int row,
             int col) {
        visited[row][col] = 1;
        queue<pair<int, int>> que;
        int m = grid[0].size();
        int n = grid.size();
        que.push({row, col});

        while (!que.empty()) {
            int row = que.front().first;
            int col = que.front().second;
            que.pop();

            int delRow[4] = {-1, 0, 1, 0};
            int delCol[4] = {0, 1, 0, -1};

            for (int i = 0; i < 4; i++) {
                int nrow = row + delRow[i];
                int ncol = col + delCol[i];
                if (nrow >= 0 && nrow < n && ncol >= 0 && ncol < m &&
                    grid[nrow][ncol] == '1' &&
                    visited[nrow][ncol] ==0) { // Saare Adjust node check karte hai
                    visited[nrow][ncol] = 1;
                    que.push({nrow, ncol});
                }
            }
        }
    }

    int numIslands(vector<vector<char>>& grid) {
        int count = 0;
        int col = grid[0].size();
        int row = grid.size();
        vector<vector<int>> visited(row, vector<int>(col, 0));

        for (int i = 0; i < row; i++) {
            for (int j = 0; j < col; j++) {

                if (grid[i][j] == '1') {
                    if (visited[i][j] == 0) {
                        visited[i][j] = 1;
                        count++;
                        bfs(visited, grid, i, j);
                    }
                }
            }
        }
        return count;
    }
};
