class Solution {
public:
    vector<int> countPoints(vector<vector<int>>& points, vector<vector<int>>& query) {
        vector<int> ans;
        int n = query.size();
        int m = points.size();

        for(int i=0; i<n; i++) {
            int x = query[i][0];
            int y = query[i][1];
            int r = query[i][2];

            int cnt = 0;

            for(int j=0; j<m; j++) {
                int xi = points[j][0];
                int yi = points[j][1];

                if( (x-xi)*(x-xi) + (y-yi)*(y-yi) <= r*r ) cnt++;
            }

            ans.push_back(cnt);
        }

        return ans;
    }
};
