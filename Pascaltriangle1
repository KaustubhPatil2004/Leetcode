class Solution {
public:
    int solver(int row,int col,vector<vector<int>>&dp){
        if(col==0 || col==row){
            return 1;
        }
        if(dp[row][col]!=-1) return dp[row][col];
        return dp[row][col]=solver(row-1,col,dp)+solver(row-1,col-1,dp);
    }
    vector<int> getRow(int rowIndex) {
        vector<vector<int>>dp(rowIndex+1,vector<int>(rowIndex+1,-1));
        vector<vector<int>>ans;

        for(int i=0;i<=rowIndex;i++){
            vector<int>ansfinal;
            for(int k=0;k<=i;k++){
                ansfinal.push_back(solver(i,k,dp));
            }
            ans.push_back(ansfinal);
        }
       return ans.back();
    }
};
