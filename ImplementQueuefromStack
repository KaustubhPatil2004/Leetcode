class MyQueue {
public:
    stack<int> st;
    stack<int> s;
    MyQueue() {}

    void push(int x) { s.push(x); }

    int pop() {
        if (st.empty()) {
            while (!s.empty()) {
                int val = s.top();
                s.pop();
                st.push(val);
            }
        }
        int nik = st.top();
        st.pop();
        return nik;
    }

    int peek() {
        if (st.empty()) {
            while (!s.empty()) {
                int val = s.top();
                s.pop();
                st.push(val);
            }
        }
        return st.top();
    }

    bool empty() { return (st.empty()) && (s.empty()); }

};

